# ============================================================================
# LAZARUS Backup Manager — конфигурация (короткая версия)
# ============================================================================
#
#   🟢 НОВИЧКУ ЭТОТ ФАЙЛ НЕ НУЖЕН.
#   Ничего не копируйте и не заполняйте — просто запустите:  lazarus
#   Мастер первого запуска сам спросит, что бэкапить, и включит уведомления,
#   шифрование, авто-бэкап и облако. Панель, бота и infra-billing скрипт найдёт
#   сам (по образам и docker-меткам — имена контейнеров и пути не важны).
#   Проверить, что нашлось:  lazarus stacks
#
#   ⚠️  Если скопировать этот файл в config.env — дружелюбный МАСТЕР ПЕРВОГО
#   ЗАПУСКА НЕ появится (настройки уже будут заданы). Копируйте ТОЛЬКО если
#   осознанно готовите конфиг заранее: автоматизация, массовые установки.
#
# Для продвинутых — скопировать и заполнить только нужное:
#   cp config.env.sample config.env
#
# ПОЛНЫЙ справочник всех ключей (SSH-бэкап с другого сервера, S3, тайминги,
# ротация, тонкая настройка): CONFIG_REFERENCE.md
# ============================================================================

# --- 1. Telegram-уведомления (единственное, что стоит заполнить руками) ---
BOT_TOKEN=""                    # токен бота от @BotFather
CHAT_ID=""                      # ваш chat ID или ID группы

# --- 2. Что бэкапим ---
# panel = панель Remnawave (рекомендуется) · bot = телеграм-бот rwp_shop
# BACKUP_SECONDARY="bot" — если панель И бот на ОДНОМ сервере (бэкап обоих одним прогоном).
# Пути и контейнеры указывать НЕ нужно — найдутся сами.
BACKUP_TARGET="panel"
BACKUP_SECONDARY=""

# --- 3. Расписание (можно настроить и в меню: lazarus → Автоматизация) ---
SCHEDULE_FULL="Выкл"            # напр. "Ежедневно 04:00"
SCHEDULE_DB="Выкл"
SCHEDULE_FILES="Выкл"

# --- 4. Хранение ---
RETENTION_DAYS="7"              # сколько дней хранить бэкапы локально
S3_RETENTION_DAYS="0"           # сколько дней хранить на S3/R2 (0 = не удалять; трогает только свои архивы)
COMPRESSION="gzip"              # gzip (везде есть) | zstd (быстрее и меньше, нужен apt install zstd)

# ============================================================================
# Всё остальное имеет разумные значения по умолчанию и/или настраивается в меню:
# шифрование (пароль — в отдельном файле .password), удалённые хранилища
# (S3/FTP/WebDAV/rclone), бэкап цели на ДРУГОМ сервере по SSH, infra-billing
# (найдётся сам), исключения файлов, таймауты, мониторинг диска.
# Список и описание всех ключей: CONFIG_REFERENCE.md
# ============================================================================
